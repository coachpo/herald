# Optional shell/Compose configuration. Do not put real credentials in Git.
HERALD_DATA_DIR=./data
HERALD_HOST=127.0.0.1
HERALD_PORT=8000
HERALD_DELIVERY_TIMEOUT=10
HERALD_MAX_ATTEMPTS=5
HERALD_BACKOFF_BASE=5
HERALD_BACKOFF_MAX=300
HERALD_CONCURRENCY=4
HERALD_RETENTION_DAYS=30
# By default credentials are generated in HERALD_DATA_DIR/credentials.env.
# To override credentials securely, provide ALL three variables together:
# HERALD_ADMIN_TOKEN=
# HERALD_INGEST_TOKEN=
# HERALD_ENCRYPTION_KEY=
