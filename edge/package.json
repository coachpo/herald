{
  "name": "herald-edge",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c cloudflare/wrangler.toml",
    "deploy": "wrangler deploy -c cloudflare/wrangler.toml",
    "lint": "find shared cloudflare edgeone tests -name '*.mjs' -o -name '*.js' | xargs -n1 node --check",
    "pretest": "bash edgeone/build.sh",
    "test": "node --test tests/*.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.32.0"
  }
}
